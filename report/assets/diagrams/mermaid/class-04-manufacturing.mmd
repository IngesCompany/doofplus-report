---
title: "Class Diagram – Manufacturing & Batch Management Bounded Context"
---
classDiagram
  direction LR
  class Product {
    <<Aggregate Root>>
    -Long id
    -String code
    -String name
    -DosageForm dosageForm
    +Product(CreateProductCommand command)
    +update(UpdateProductCommand command) void
  }
  class MasterFormula {
    <<Aggregate Root>>
    -Long id
    -String productCode
    -String version
    -FormulaStatus status
    -BigDecimal batchSize
    -String approvedBy
    -LocalDate approvedAt
    -List~FormulaItem~ items
    +MasterFormula(CreateMasterFormulaCommand command)
    +approve(ApproveMasterFormulaCommand command) void
    +lock() void
    +isApproved() boolean
  }
  class FormulaItem {
    <<Entity>>
    -Long id
    -FormulaItemKind kind
    -String name
    -String role
    -String target
    -String tolerance
    -String control
  }
  class RawMaterialLot {
    <<Aggregate Root>>
    -Long id
    -String code
    -String receiptCode
    -String material
    -MaterialCategory category
    -String supplier
    -String supplierLot
    -String quantity
    -String storageLocation
    -String certificate
    -MaterialLotStatus status
    -SamplingStatus samplingStatus
    -boolean packagingVerified
    -boolean identityVerified
    -LocalDate expiryDate
    -String allocatedBatch
    +RawMaterialLot(ReceiveRawMaterialLotCommand command)
    +inspect(InspectRawMaterialLotCommand command) void
    +approve() void
    +reject() void
    +allocate(AllocateRawMaterialLotCommand command) void
  }
  class ProductionOrder {
    <<Aggregate Root>>
    -Long id
    -String code
    -String productCode
    -Long masterFormulaId
    -String batchCode
    -String line
    -BigDecimal plannedQuantity
    -ProductionOrderStatus status
    -LocalDateTime plannedStart
    -LocalDateTime plannedEnd
    -List~Operation~ operations
    +ProductionOrder(CreateProductionOrderCommand command, String productCode)
    +changeStatus(ProductionOrderStatus status) void
    +updateOperation(UpdateOperationCommand command) boolean
  }
  class Operation {
    <<Entity>>
    -Long id
    -int sequence
    -String name
    -String equipment
    -int progress
    -OperationStatus status
    -String reference
    +update(UpdateOperationCommand command) void
  }
  class ProductionBatch {
    <<Aggregate Root>>
    -Long id
    -BatchNumber batchNumber
    -Long productionOrderId
    -BatchStatus status
    -String line
    -String owner
    -int progress
    -Quantity plannedQuantity
    -Quantity manufacturedQuantity
    -LocalDateTime startedAt
    -LocalDateTime finishedAt
    -List~MaterialConsumption~ consumptions
    -List~Incident~ incidents
    -List~BatchEvent~ events
    +ProductionBatch(CreateBatchCommand command)
    +start() void
    +consumeMaterial(Long rawMaterialLotId, Quantity quantity) void
    +updateProgress(UpdateBatchProgressCommand command) void
    +registerIncident(RegisterIncidentCommand command) Incident
    +resume() void
    +close(CloseBatchCommand command) void
    +release(ReleaseBatchCommand command) void
  }
  class MaterialConsumption {
    <<Entity>>
    -Long id
    -Long rawMaterialLotId
    -Quantity consumedQuantity
    -LocalDateTime consumedAt
  }
  class Incident {
    <<Entity>>
    -Long id
    -String description
    -IncidentSeverity severity
    -IncidentStatus status
    -LocalDateTime recordedAt
    +escalate() void
    +resolve(String resolution) void
  }
  class BatchEvent {
    <<Entity>>
    -Long id
    -String type
    -String description
    -EventTone tone
    -Long performedBy
    -LocalDateTime occurredAt
  }
  class BatchNumber {
    <<Value Object>>
    +String value
  }
  class Quantity {
    <<Value Object>>
    +BigDecimal value
    +String unit
  }
  class BatchStatus {
    <<enumeration>>
    PLANNED
    IN_PROGRESS
    ON_HOLD
    RELEASE_REQUESTED
    RELEASED
  }
  class ProductionOrderStatus {
    <<enumeration>>
    PLANNED
    APPROVED
    IN_PROGRESS
    ON_HOLD
    COMPLETED
  }
  class OperationStatus {
    <<enumeration>>
    NOT_STARTED
    IN_PROGRESS
    ON_HOLD
    COMPLETE
  }
  class MaterialLotStatus {
    <<enumeration>>
    QUARANTINE
    SAMPLING
    INSPECTION
    APPROVED
    REJECTED
  }
  class SamplingStatus {
    <<enumeration>>
    PENDING
    REQUESTED
    DONE
  }
  class MaterialCategory {
    <<enumeration>>
    API
    EXCIPIENT
    PACKAGING
  }
  class DosageForm {
    <<enumeration>>
    TABLET
    CAPSULE
    SYRUP
    INJECTABLE
  }
  class FormulaStatus {
    <<enumeration>>
    DRAFT
    PENDING
    APPROVED
    LOCKED
  }
  class FormulaItemKind {
    <<enumeration>>
    COMPONENT
    PARAMETER
  }
  class IncidentSeverity {
    <<enumeration>>
    MINOR
    MAJOR
    CRITICAL
  }
  class IncidentStatus {
    <<enumeration>>
    OPEN
    ESCALATED
    RESOLVED
  }
  class EventTone {
    <<enumeration>>
    NORMAL
    WARNING
    DANGER
  }
  class ProductionBatchRepository {
    <<interface>>
    +findByBatchNumber(BatchNumber batchNumber) Optional~ProductionBatch~
    +existsByBatchNumber(BatchNumber batchNumber) boolean
  }
  class ProductionBatchCommandService {
    <<interface>>
    +handle(CreateBatchCommand command) Result~ProductionBatch, ApplicationError~
    +handle(RegisterIncidentCommand command) Result~Incident, ApplicationError~
    +handle(CloseBatchCommand command) Result~ProductionBatch, ApplicationError~
    +handle(UpdateBatchProgressCommand command) Result~ProductionBatch, ApplicationError~
    +handle(StartBatchCommand command) Result~ProductionBatch, ApplicationError~
    +handle(ResumeBatchCommand command) Result~ProductionBatch, ApplicationError~
    +handle(ReleaseBatchCommand command) Result~ProductionBatch, ApplicationError~
  }
  class ExternalQualityService {
    +requestMaterialSampling(Long rawMaterialLotId) Long
    +requestBatchRelease(Long batchId) Long
  }
  MasterFormula "0..*" --> "1" Product : defines
  MasterFormula "1" *-- "1..*" FormulaItem : contains
  ProductionOrder "0..*" --> "1" MasterFormula : follows
  ProductionOrder "1" *-- "0..*" Operation : routedThrough
  ProductionBatch "0..*" --> "1" ProductionOrder : executes
  ProductionBatch "1" *-- "0..*" MaterialConsumption : consumes
  ProductionBatch "1" *-- "0..*" Incident : registers
  ProductionBatch "1" *-- "0..*" BatchEvent : timeline
  MaterialConsumption "0..*" --> "1" RawMaterialLot : uses
  ProductionBatch *-- BatchNumber : batchNumber
  ProductionBatch --> BatchStatus : status
  ProductionOrder --> ProductionOrderStatus : status
  Operation --> OperationStatus : status
  RawMaterialLot --> MaterialLotStatus : status
  RawMaterialLot --> SamplingStatus : samplingStatus
  RawMaterialLot --> MaterialCategory : category
  Product --> DosageForm : dosageForm
  MasterFormula --> FormulaStatus : status
  FormulaItem --> FormulaItemKind : kind
  Incident --> IncidentSeverity : severity
  Incident --> IncidentStatus : status
  BatchEvent --> EventTone : tone
  ProductionBatchRepository ..> ProductionBatch : persists
  ProductionBatchCommandService ..> ExternalQualityService : uses
