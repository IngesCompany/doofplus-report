---
title: "Class Diagram – IAM Bounded Context"
---
classDiagram
  direction LR
  class AbstractDomainAggregateRoot~T~ {
    <<abstract>>
    #registerDomainEvent(Object event) void
  }
  class User {
    <<Aggregate Root>>
    -Long id
    -Long organizationId
    -Long facilityId
    -String fullName
    -EmailAddress email
    -String passwordHash
    -String mfaSecret
    -UserStatus status
    -int failedSignInAttempts
    -Set~Role~ roles
    +User(SignUpCommand command, String passwordHash, List~Role~ roles)
    +activate(String passwordHash, String mfaSecret) void
    +assignRole(Role role) User
    +registerFailedSignIn() void
    +resetFailedSignIns() void
    +lock() void
    +isLocked() boolean
  }
  class Role {
    <<Entity>>
    -Long id
    -Roles name
    +getStringName() String
  }
  class Invitation {
    <<Aggregate Root>>
    -Long id
    -Long organizationId
    -Long facilityId
    -Role role
    -String fullName
    -EmailAddress email
    -String note
    -InvitationStatus status
    -LocalDateTime sentAt
    +Invitation(SendInvitationCommand command)
    +accept() void
    +expire() void
  }
  class ElectronicSignature {
    <<Aggregate Root>>
    -Long id
    -Long userId
    -String entityType
    -Long entityId
    -SignatureMeaning meaning
    -LocalDateTime signedAt
    +ElectronicSignature(SignRecordCommand command)
  }
  class EmailAddress {
    <<Value Object>>
    +String address
  }
  class Roles {
    <<enumeration>>
    ROLE_ADMINISTRATOR
    ROLE_QA_SPECIALIST
    ROLE_QUALITY_MANAGER
    ROLE_PRODUCTION_SUPERVISOR
    ROLE_INTERNAL_AUDITOR
  }
  class UserStatus {
    <<enumeration>>
    INVITED
    ACTIVE
    LOCKED
    DISABLED
  }
  class InvitationStatus {
    <<enumeration>>
    PENDING
    ACCEPTED
    EXPIRED
  }
  class SignatureMeaning {
    <<enumeration>>
    AUTHORED
    REVIEWED
    APPROVED
    RELEASED
  }
  class UserRepository {
    <<interface>>
    +findByEmail(EmailAddress email) Optional~User~
    +existsByEmail(EmailAddress email) boolean
  }
  class InvitationRepository {
    <<interface>>
    +findAllByOrganizationId(Long organizationId) List~Invitation~
  }
  class ElectronicSignatureRepository {
    <<interface>>
    +findByEntityTypeAndEntityId(String entityType, Long entityId) List~ElectronicSignature~
  }
  class UserCommandService {
    <<interface>>
    +handle(SignUpCommand command) Result~User, ApplicationError~
    +handle(SignInCommand command) Result~AuthenticatedUser, ApplicationError~
    +handle(AssignRoleCommand command) Result~User, ApplicationError~
  }
  class InvitationCommandService {
    <<interface>>
    +handle(SendInvitationCommand command) Result~Invitation, ApplicationError~
    +handle(AcceptInvitationCommand command) Result~User, ApplicationError~
  }
  class SignatureCommandService {
    <<interface>>
    +handle(SignRecordCommand command) Result~ElectronicSignature, ApplicationError~
  }
  class TokenService {
    <<interface>>
    +generateToken(String username) String
    +validateToken(String token) boolean
  }
  class HashingService {
    <<interface>>
    +encode(CharSequence rawPassword) String
    +matches(CharSequence rawPassword, String encodedPassword) boolean
  }
  class TotpService {
    <<interface>>
    +verifyCode(String secret, String code) boolean
  }
  class IamContextFacade {
    +createAdministrator(Long organizationId, String fullName, String email, String password) Long
    +signRecord(Long userId, String password, String entityType, Long entityId, String meaning) Long
  }
  AbstractDomainAggregateRoot <|-- User
  AbstractDomainAggregateRoot <|-- Invitation
  AbstractDomainAggregateRoot <|-- ElectronicSignature
  User "0..*" o-- "1..*" Role : has
  User *-- EmailAddress : email
  User --> UserStatus : status
  Invitation "0..*" --> "1" Role : offers
  Invitation --> InvitationStatus : status
  Role --> Roles : name
  ElectronicSignature "0..*" --> "1" User : signedBy
  ElectronicSignature --> SignatureMeaning : meaning
  UserRepository ..> User : persists
  InvitationRepository ..> Invitation : persists
  ElectronicSignatureRepository ..> ElectronicSignature : persists
  UserCommandService ..> TokenService : uses
  UserCommandService ..> HashingService : uses
  UserCommandService ..> TotpService : uses
  InvitationCommandService ..> UserCommandService : createsUser
  SignatureCommandService ..> HashingService : verifiesIdentity
  IamContextFacade ..> UserCommandService : delegates
  IamContextFacade ..> SignatureCommandService : delegates
