---
title: "Class Diagram – IoT Monitoring Bounded Context"
---
classDiagram
  direction LR
  class Equipment {
    <<Aggregate Root>>
    -Long id
    -EquipmentCode code
    -String name
    -String model
    -Facility location
    -CalibrationStatus calibrationStatus
    -LocalDate calibrationDue
    -String certificate
    -LocalDate nextMaintenance
    -String maintenanceOwner
    -String workOrder
    -String healthNote
    -List~CalibrationRecord~ calibrations
    -List~MaintenanceRecord~ maintenances
    +Equipment(CreateEquipmentCommand command)
    +update(UpdateEquipmentCommand command) Equipment
    +registerCalibration(LocalDate validUntil, String certificate) void
    +registerMaintenance(String workOrder, LocalDate nextDueDate) void
    +isFitForUse() boolean
  }
  class CalibrationRecord {
    <<Entity>>
    -Long id
    -LocalDate calibratedAt
    -LocalDate validUntil
    -String certificate
  }
  class MaintenanceRecord {
    <<Entity>>
    -Long id
    -LocalDate performedAt
    -String workOrder
    -String owner
    -LocalDate nextDueDate
  }
  class Sensor {
    <<Aggregate Root>>
    -Long id
    -SensorCode code
    -DeviceId deviceId
    -SensorType type
    -String unit
    -String equipmentCode
    -Double lowerLimit
    -Double upperLimit
    -SensorStatus status
    -String assignedBatch
    +Sensor(CreateSensorCommand command)
    +update(UpdateSensorCommand command) Sensor
    +assignBatch(String batchCode) void
    +isOutOfRange(Double value) boolean
  }
  class Reading {
    <<Aggregate Root>>
    -Long id
    -String sensorCode
    -String batchCode
    -Double value
    -LocalDateTime recordedAt
    -String source
    +Reading(CreateReadingCommand command)
  }
  class Alert {
    <<Aggregate Root>>
    -Long id
    -AlertCode code
    -String sensorCode
    -String equipmentCode
    -String batchCode
    -AlertSeverity severity
    -AlertStatus status
    -String title
    -String detail
    -String acknowledgedBy
    -LocalDateTime acknowledgedAt
    -String responseNote
    -String linkedRecord
    +Alert(CreateAlertCommand command)
    +acknowledge(String user, String responseNote) void
    +linkRecord(String recordCode) void
    +close() void
  }
  class EquipmentCode {
    <<Value Object>>
    +String value
  }
  class SensorCode {
    <<Value Object>>
    +String value
  }
  class DeviceId {
    <<Value Object>>
    +String value
  }
  class AlertCode {
    <<Value Object>>
    +String value
  }
  class Facility {
    <<Value Object>>
    +String value
  }
  class CalibrationStatus {
    <<enumeration>>
    FIT
    DUE
    NOT_FIT
  }
  class SensorType {
    <<enumeration>>
    TEMPERATURE
    HUMIDITY
    PRESSURE
  }
  class SensorStatus {
    <<enumeration>>
    ACTIVE
    OFFLINE
  }
  class AlertSeverity {
    <<enumeration>>
    WARNING
    CRITICAL
  }
  class AlertStatus {
    <<enumeration>>
    OPEN
    ACKNOWLEDGED
    UNDER_INVESTIGATION
    CLOSED
  }
  class ReadingCommandService {
    <<interface>>
    +handle(CreateReadingCommand command) Result~Reading, ApplicationError~
  }
  class SensorCommandService {
    <<interface>>
    +handle(CreateSensorCommand command) Result~Sensor, ApplicationError~
    +handle(UpdateSensorCommand command) Result~Sensor, ApplicationError~
  }
  class AlertCommandService {
    <<interface>>
    +handle(CreateAlertCommand command) Result~Alert, ApplicationError~
    +handle(UpdateAlertCommand command) Result~Alert, ApplicationError~
  }
  class SensorRepository {
    <<interface>>
    +findByCode(SensorCode code) Optional~Sensor~
    +findByDeviceId(DeviceId deviceId) Optional~Sensor~
    +findAllByEquipmentCode(String equipmentCode) List~Sensor~
  }
  class ExternalManufacturingService {
    +isBatchInProgress(String batchCode) boolean
  }
  class NotificationService {
    <<interface>>
    +publishAlert(Alert alert) void
  }
  Equipment "1" *-- "0..*" CalibrationRecord : calibrations
  Equipment "1" *-- "0..*" MaintenanceRecord : maintenances
  Equipment *-- EquipmentCode : code
  Equipment *-- Facility : location
  Equipment --> CalibrationStatus : calibrationStatus
  Sensor "0..*" --> "1" Equipment : installedOn
  Sensor *-- SensorCode : code
  Sensor *-- DeviceId : deviceId
  Sensor --> SensorType : type
  Sensor --> SensorStatus : status
  Reading "0..*" --> "1" Sensor : emittedBy
  Alert "0..*" --> "1" Sensor : raisedBy
  Alert *-- AlertCode : code
  Alert --> AlertSeverity : severity
  Alert --> AlertStatus : status
  ReadingCommandService ..> AlertCommandService : raisesAlert
  ReadingCommandService ..> ExternalManufacturingService : uses
  AlertCommandService ..> NotificationService : uses
  SensorRepository ..> Sensor : persists
