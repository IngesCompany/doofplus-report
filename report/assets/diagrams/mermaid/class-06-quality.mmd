---
title: "Class Diagram – Quality & Compliance Bounded Context"
---
classDiagram
  direction LR
  class QualityDocument {
    <<Aggregate Root>>
    -Long id
    -String code
    -String version
    -String title
    -DocumentStatus status
    -Long authorId
    -Long technicalReviewerId
    -Long approverId
    -LocalDate changedAt
    -DocumentContent content
    -int reviewCycleMonths
    +submitForReview() void
    +approve(Long signatureId) void
    +publishNewVersion(String version, DocumentContent content) QualityDocument
    +markAsObsolete() void
  }
  class DocumentContent {
    <<Value Object>>
    +String purpose
    +String scope
    +String procedure
    +String revisionSummary
  }
  class AnalyticalResult {
    <<Aggregate Root>>
    -Long id
    -String batchCode
    -String sampleCode
    -String reportCode
    -String testName
    -String protocol
    -String result
    -String specification
    -Long analystId
    -ResultStatus status
    -ApprovalState approval
    +evaluate() void
    +approve() void
  }
  class BatchRelease {
    <<Aggregate Root>>
    -Long id
    -String batchCode
    -Long requestedBy
    -ReleaseStatus status
    -String decision
    -Long signatureId
    -LocalDateTime signedAt
    +release(Long signatureId) void
    +reject(String decision) void
  }
  class Evidence {
    <<Aggregate Root>>
    -Long id
    -String recordCode
    -String fileName
    -String detail
    -EvidenceStatus status
    +markAsReviewed() void
  }
  class Deviation {
    <<Aggregate Root>>
    -Long id
    -String code
    -String title
    -String batchCode
    -String orderCode
    -String summary
    -Classification classification
    -String containment
    -RiskScore risk
    -DeviationStatus status
    -String rootCause
    -Long reportedBy
    -LocalDateTime reportedAt
    -Long ownerId
    -LocalDateTime dueAt
    +classify(Classification classification, RiskScore risk) void
    +registerRootCause(String rootCause) void
    +submit() void
    +disposition() void
    +close() void
  }
  class RiskScore {
    <<Value Object>>
    +int severity
    +int likelihood
    +int detectability
  }
  class CapaPlan {
    <<Aggregate Root>>
    -Long id
    -String code
    -Long deviationId
    -String title
    -Long ownerId
    -Long reviewerId
    -String rootCause
    -String acceptanceCriterion
    -LocalDate effectivenessCheckAt
    -CapaStatus status
    -List~CapaAction~ actions
    +addAction(CapaType type, String title, Long ownerId, LocalDate dueAt) CapaAction
    +submitForApproval() void
    +close() void
  }
  class CapaAction {
    <<Entity>>
    -Long id
    -String code
    -CapaType type
    -String title
    -Long ownerId
    -LocalDate dueAt
    -ActionStatus status
    -String evidence
    -boolean evidenceAttached
    +attachEvidence() void
    +complete() void
  }
  class Audit {
    <<Aggregate Root>>
    -Long id
    -String code
    -String title
    -String period
    -int areasReviewed
    -int areasTotal
    -AuditStatus status
    -List~AuditFinding~ findings
    +start() void
    +registerFinding(String title, Classification classification) AuditFinding
    +close() void
  }
  class AuditFinding {
    <<Entity>>
    -Long id
    -String code
    -String title
    -Classification classification
    -Long ownerId
    -LocalDate dueAt
    -FindingStatus status
    -String observation
    -String response
    -String closureRequirement
    +respond(String response) void
    +close() void
  }
  class AuditEvent {
    <<Aggregate Root>>
    -Long id
    -String eventCode
    -LocalDateTime occurredAt
    -Long actorId
    -String actorRole
    -String event
    -String recordCode
    -EventResult result
    -String field
    -String beforeValue
    -String afterValue
    -String reason
  }
  class RegulatoryReport {
    <<Aggregate Root>>
    -Long id
    -String code
    -ReportType type
    -String scope
    -Long ownerId
    -ReportStatus status
    -String template
    -String format
    +approve() void
  }
  class CollaborationTask {
    <<Aggregate Root>>
    -Long id
    -String title
    -String recordCode
    -String detail
    -Long ownerId
    -LocalDateTime dueAt
    -TaskStatus status
    +changeStatus(TaskStatus status) void
  }
  class TaskComment {
    <<Aggregate Root>>
    -Long id
    -String recordCode
    -Long authorId
    -LocalDateTime postedAt
    -String text
  }
  class TraceabilityGap {
    <<Aggregate Root>>
    -Long id
    -String batchCode
    -String missingRecord
    -String detail
    -GapStatus status
    +resolve() void
  }
  class DocumentStatus {
    <<enumeration>>
    DRAFT
    IN_REVIEW
    APPROVED
    OBSOLETE
  }
  class ResultStatus {
    <<enumeration>>
    WITHIN
    OOS
    PENDING
  }
  class ApprovalState {
    <<enumeration>>
    REQUESTED
    APPROVED
  }
  class ReleaseStatus {
    <<enumeration>>
    PENDING
    RELEASED
    REJECTED
  }
  class EvidenceStatus {
    <<enumeration>>
    ATTACHED
    PENDING_REVIEW
    REVIEWED
  }
  class Classification {
    <<enumeration>>
    MINOR
    MAJOR
    CRITICAL
  }
  class DeviationStatus {
    <<enumeration>>
    OPEN
    SUBMITTED
    DISPOSITIONED
    CLOSED
  }
  class CapaStatus {
    <<enumeration>>
    DRAFT
    IN_PROGRESS
    IN_APPROVAL
    CLOSED
  }
  class CapaType {
    <<enumeration>>
    CORRECTIVE
    PREVENTIVE
  }
  class ActionStatus {
    <<enumeration>>
    OPEN
    PLANNED
    IN_REVIEW
    COMPLETE
  }
  class AuditStatus {
    <<enumeration>>
    SCHEDULED
    IN_PROGRESS
    CLOSED
  }
  class FindingStatus {
    <<enumeration>>
    EVIDENCE_PENDING
    IN_REVIEW
    CLOSED
  }
  class EventResult {
    <<enumeration>>
    RECORDED
    BLOCKED
    ON_HOLD
    ACKNOWLEDGED
  }
  class ReportType {
    <<enumeration>>
    BATCH_DOSSIER
    QUALITY_REVIEW
    CAPA_SUMMARY
    AUDIT_EVIDENCE
  }
  class ReportStatus {
    <<enumeration>>
    DRAFT
    BLOCKED
    APPROVED
  }
  class TaskStatus {
    <<enumeration>>
    TO_DO
    OPEN
    PENDING
    IN_REVIEW
    READY
    DONE
  }
  class GapStatus {
    <<enumeration>>
    OPEN
    UNDER_REVIEW
    RESOLVED
  }
  class DeviationCommandService {
    <<interface>>
    +handle(RegisterDeviationCommand command) Result~Deviation, ApplicationError~
    +handle(CloseDeviationCommand command) Result~Deviation, ApplicationError~
  }
  class BatchReleaseCommandService {
    <<interface>>
    +handle(RequestBatchReleaseCommand command) Result~BatchRelease, ApplicationError~
    +handle(ReleaseBatchCommand command) Result~BatchRelease, ApplicationError~
  }
  class ReportGenerationService {
    <<interface>>
    +generateReport(RegulatoryReport report) byte[]
  }
  class NotificationService {
    <<interface>>
    +notifyCriticalDeviation(Deviation deviation) void
  }
  class ExternalIamService {
    +signRecord(Long userId, String password, String entityType, Long entityId) Optional~Long~
  }
  class ExternalManufacturingService {
    +fetchBatchStatus(String batchCode) Optional~String~
  }
  QualityDocument *-- DocumentContent : content
  QualityDocument --> DocumentStatus : status
  AnalyticalResult --> ResultStatus : status
  AnalyticalResult --> ApprovalState : approval
  BatchRelease ..> AnalyticalResult : checks
  BatchRelease --> ReleaseStatus : status
  Evidence --> EvidenceStatus : status
  Deviation *-- RiskScore : risk
  Deviation --> Classification : classification
  Deviation --> DeviationStatus : status
  CapaPlan "0..1" --> "1" Deviation : addresses
  CapaPlan "1" *-- "1..*" CapaAction : actions
  CapaPlan --> CapaStatus : status
  CapaAction --> CapaType : type
  CapaAction --> ActionStatus : status
  Audit "1" *-- "0..*" AuditFinding : findings
  Audit --> AuditStatus : status
  AuditFinding --> FindingStatus : status
  AuditEvent --> EventResult : result
  RegulatoryReport --> ReportType : type
  RegulatoryReport --> ReportStatus : status
  CollaborationTask --> TaskStatus : status
  TraceabilityGap --> GapStatus : status
  DeviationCommandService ..> NotificationService : uses
  BatchReleaseCommandService ..> ExternalIamService : uses
  BatchReleaseCommandService ..> ExternalManufacturingService : uses
  ReportGenerationService ..> AuditEvent : reads
  ReportGenerationService ..> RegulatoryReport : creates
