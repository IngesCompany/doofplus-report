---
title: "Class Diagram – Organizations & Profiles Bounded Context"
---
classDiagram
  direction LR
  class Organization {
    <<Aggregate Root>>
    -Long id
    -String legalName
    -Ruc ruc
    -String region
    -String ownerName
    -OrganizationStatus status
    -List~Facility~ facilities
    +Organization(RegisterOrganizationCommand command)
    +addFacility(String name, FacilityType type, String timezone) Facility
    +verify() void
    +deactivate() void
  }
  class Facility {
    <<Entity>>
    -Long id
    -String name
    -FacilityType type
    -String timezone
    -String ownerName
    -FacilityStatus status
  }
  class Ruc {
    <<Value Object>>
    +String value
    +Ruc(String value)
  }
  class UserProfile {
    <<Aggregate Root>>
    -Long id
    -Long userId
    -Long organizationId
    -PersonName name
    -String email
    -Area area
    -String site
    -String language
    -NotificationPreferences preferences
    +updatePreferences(NotificationPreferences preferences) void
    +changeLanguage(String language) void
  }
  class PersonName {
    <<Value Object>>
    +String firstName
    +String lastName
    +getFullName() String
  }
  class NotificationPreferences {
    <<Value Object>>
    +boolean emailEnabled
    +boolean inAppEnabled
  }
  class AdministrativeActivity {
    <<Aggregate Root>>
    -Long id
    -Long organizationId
    -String title
    -String actor
    -LocalDateTime occurredAt
  }
  class ContactInquiry {
    <<Aggregate Root>>
    -Long id
    -String fullName
    -String email
    -String message
    -InquiryStatus status
    -LocalDateTime receivedAt
    +ContactInquiry(SendContactInquiryCommand command)
    +markAsAnswered() void
  }
  class OrganizationStatus {
    <<enumeration>>
    ACTIVE
    PENDING
    PENDING_VERIFICATION
    INACTIVE
  }
  class FacilityType {
    <<enumeration>>
    MANUFACTURING
    QC_LABORATORY
  }
  class FacilityStatus {
    <<enumeration>>
    ACTIVE
    INACTIVE
  }
  class Area {
    <<enumeration>>
    QUALITY
    PRODUCTION
    ADMINISTRATION
  }
  class InquiryStatus {
    <<enumeration>>
    RECEIVED
    ANSWERED
  }
  class OrganizationRepository {
    <<interface>>
    +existsByRuc(Ruc ruc) boolean
  }
  class UserProfileRepository {
    <<interface>>
    +findByUserId(Long userId) Optional~UserProfile~
  }
  class OrganizationCommandService {
    <<interface>>
    +handle(RegisterOrganizationCommand command) Result~Organization, ApplicationError~
    +handle(AddFacilityCommand command) Result~Facility, ApplicationError~
  }
  class UserProfileCommandService {
    <<interface>>
    +handle(UpdateUserProfilePreferencesCommand command) Result~UserProfile, ApplicationError~
  }
  class ContactInquiryCommandService {
    <<interface>>
    +handle(SendContactInquiryCommand command) Result~ContactInquiry, ApplicationError~
  }
  class ExternalIamService {
    +createAdministrator(Long organizationId, String fullName, String email, String password) Optional~Long~
  }
  Organization "1" *-- "1..*" Facility : operates
  Organization *-- Ruc : ruc
  Organization --> OrganizationStatus : status
  Facility --> FacilityType : type
  Facility --> FacilityStatus : status
  UserProfile "0..*" --> "1" Organization : belongsTo
  UserProfile *-- PersonName : name
  UserProfile *-- NotificationPreferences : preferences
  UserProfile --> Area : area
  AdministrativeActivity "0..*" --> "1" Organization : loggedFor
  ContactInquiry --> InquiryStatus : status
  OrganizationRepository ..> Organization : persists
  UserProfileRepository ..> UserProfile : persists
  OrganizationCommandService ..> ExternalIamService : uses
  UserProfileCommandService ..> UserProfileRepository : uses
