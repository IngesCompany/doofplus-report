---
title: "Database Diagram – Quality & Compliance Bounded Context (MySQL 8)"
---
erDiagram
  direction LR
  quality_documents {
    bigint id PK
    varchar(30) code "UK with version"
    varchar(10) version "2.4"
    varchar(255) title
    varchar(20) status "DRAFT, IN_REVIEW, APPROVED, OBSOLETE"
    varchar(100) author "person name"
    varchar(100) technical_reviewer "person name"
    varchar(100) approver "person name"
    date changed_at
    text purpose
    text scope
    text procedure
    text revision_summary
    int review_cycle_months "12, 24"
  }
  analytical_results {
    bigint id PK
    varchar(30) batch_code "ref manufacturing.production_batches"
    varchar(30) sample_code
    varchar(30) report_code
    varchar(100) test_name
    varchar(50) protocol
    varchar(30) result "98.7 %"
    varchar(50) specification "95.0–105.0 %"
    varchar(100) analyst "person name"
    varchar(10) status "WITHIN, OOS, PENDING"
    varchar(20) approval "REQUESTED, APPROVED"
  }
  batch_releases {
    bigint id PK
    bigint batch_id "ref manufacturing.production_batches"
    varchar(30) batch_code UK "ref manufacturing.production_batches"
    varchar(100) requested_by "person name"
    varchar(20) status "PENDING, RELEASED, REJECTED"
    varchar(500) decision "nullable"
    varchar(60) signature_reference
    varchar(100) signed_by "person name"
    datetime signed_at "nullable"
  }
  evidence {
    bigint id PK
    varchar(30) record_code "DEV-26017, B-26041"
    varchar(255) file_name
    varchar(255) detail
    varchar(20) status "ATTACHED, PENDING_REVIEW, REVIEWED"
  }
  deviations {
    bigint id PK
    varchar(30) code UK "DEV-26017"
    varchar(255) title
    varchar(30) batch_code "ref manufacturing.production_batches"
    varchar(30) order_code "ref manufacturing.production_orders"
    text summary
    varchar(10) classification "MINOR, MAJOR, CRITICAL"
    text containment
    int severity "1-5"
    int likelihood "1-5"
    int detectability "1-5"
    varchar(20) status "OPEN, SUBMITTED, DISPOSITIONED, CLOSED"
    varchar(150) root_cause "nullable"
    varchar(100) reported_by "person name"
    varchar(30) capa_code "capa_plans.code"
    datetime reported_at
    varchar(100) owner "person name"
    datetime due_at
  }
  capa_plans {
    bigint id PK
    varchar(30) code UK "CAPA-26009"
    varchar(30) source_deviation "deviations.code"
    varchar(255) title
    varchar(100) owner "person name"
    varchar(100) reviewer "person name"
    varchar(150) root_cause "nullable"
    varchar(500) acceptance_criterion
    date effectiveness_check_at
    varchar(20) status "DRAFT, IN_PROGRESS, IN_APPROVAL, CLOSED"
  }
  capa_actions {
    bigint id PK
    varchar(30) capa_code "capa_plans.code"
    varchar(10) code "CA-01, PA-01"
    varchar(12) type "CORRECTIVE, PREVENTIVE"
    varchar(255) title
    varchar(100) owner "person name"
    date due_at
    varchar(20) status "OPEN, PLANNED, IN_REVIEW, COMPLETE"
    varchar(150) evidence
    tinyint(1) evidence_attached
  }
  audits {
    bigint id PK
    varchar(30) code UK "AUD-26004"
    varchar(255) title
    varchar(40) period
    int areas_reviewed
    int areas_total
    varchar(20) status "SCHEDULED, IN_PROGRESS, CLOSED"
  }
  audit_findings {
    bigint id PK
    varchar(30) audit_code "audits.code"
    varchar(10) code "F-01"
    varchar(255) title
    varchar(10) classification "MINOR, MAJOR, CRITICAL"
    varchar(100) owner "person name"
    date due_at
    varchar(20) status "EVIDENCE_PENDING, IN_REVIEW, CLOSED"
    text observation
    text response "nullable"
    text closure_requirement
  }
  audit_events {
    bigint id PK
    varchar(30) event_code UK "EVT-89416"
    datetime occurred_at
    varchar(100) actor "person name"
    varchar(40) actor_role
    varchar(100) event
    varchar(30) record_code
    varchar(100) result "free text"
    varchar(100) field
    varchar(255) before_value "nullable"
    varchar(255) after_value "nullable"
    varchar(255) reason "nullable"
  }
  regulatory_reports {
    bigint id PK
    varchar(30) code UK "RPT-26012"
    varchar(20) type "BATCH_DOSSIER, QUALITY_REVIEW, CAPA_SUMMARY, AUDIT_EVIDENCE"
    varchar(100) scope
    varchar(100) owner "person name"
    varchar(10) status "DRAFT, BLOCKED, APPROVED"
    varchar(100) template
    varchar(100) format
    date created_at
  }
  collaboration_tasks {
    bigint id PK
    varchar(255) title
    varchar(60) record_code
    varchar(255) detail
    varchar(100) owner "person name"
    datetime due_at
    varchar(10) status "TO_DO, OPEN, PENDING, IN_REVIEW, READY, DONE"
  }
  task_comments {
    bigint id PK
    varchar(30) record_code
    varchar(100) author "person name"
    varchar(5) initials
    datetime posted_at
    text text
  }
  traceability_gaps {
    bigint id PK
    varchar(30) batch_code "ref manufacturing.production_batches"
    varchar(150) product
    varchar(150) missing_record
    varchar(500) detail
    varchar(20) status "OPEN, UNDER_REVIEW, RESOLVED"
  }
  deviations ||..o| capa_plans : "source_deviation (code)"
  capa_plans ||..|{ capa_actions : "capa_code (code)"
  audits ||..o{ audit_findings : "audit_code (code)"
